generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// USER & AUTHENTICATION (Better Auth compatible)
// ==========================================

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  emailVerified       Boolean            @default(false)
  role                String?            @default("Learner")
  imageUrl            String?
  phoneNumber         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  stripeCustomerId    String?            @unique
  onboardingCompleted Boolean            @default(false)
  status              UserStatus         @default(Active)
  lastLoginAt         DateTime?
  verificationStatus  VerificationStatus @default(Pending)

  // Universal capability architecture.
  // `role` above remains temporarily for backward compatibility.
  canLearn           Boolean @default(true)
  canTeach           Boolean @default(false)
  canTutor           Boolean @default(false)
  canCreateResources Boolean @default(false)
  canPublish         Boolean @default(false)
  canSell            Boolean @default(false)
  canManageChildren  Boolean @default(false)
  canManageSchool    Boolean @default(false)

  subscription         Subscription?
  facilitatorProfile   FacilitatorProfile?
  learningProfile      LearningProfile?
  teachingProfile      TeachingProfile?
  creatorProfile       CreatorProfile?
  accounts             Account[]
  sessions             Session[]
  products             Product[]
  courses              Course[]
  enrollment           Enrollment[]
  courseEnrollments    CourseEnrollment[]   @relation("CourseLearner")
  lessonProgress       LessonProgress[]
  learnerAppointments  Appointment[]        @relation("LearnerAppointments")
  educatorAppointments Appointment[]        @relation("EducatorAppointments")
  payout               Payout[]
  enrollmentProgress   EnrollmentProgress[]
  transaction          Transaction[]
  pendingEnrollments   PendingEnrollment[]
  roles                UserRole[]
  purchases            Purchase[]
  whitrboard           Whiteboard[]
  investments          Investment[]
  investmentAccounts   InvestmentAccount[]
  videoGenerations     VideoGeneration[]
  credits              UserCredit?
  creditTransactions   CreditTransaction[]
  aiProjects           AIProject[]
  aiGenerations        AIGeneration[]
  aiAssets             AIAsset[]

  // Universal relationships and capabilities.
  capabilities               UserCapability[]
  permissions                UserPermission[]
  followers                  Follow[]                 @relation("FollowedUser")
  following                  Follow[]                 @relation("FollowingUser")
  connectionsFrom            Connection[]             @relation("ConnectionRequester")
  connectionsTo              Connection[]             @relation("ConnectionReceiver")
  availabilities             Availability[]
  studentBookings            Booking[]                @relation("StudentBookings")
  educatorBookings           Booking[]                @relation("EducatorBookings")
  services                   Service[]
  organizationMemberships    OrganizationMembership[]
  organizationOwnerships     Organization[]
  classroomStudents          ClassroomStudent[]
  classroomTeachers          ClassroomTeacher[]
  familyMemberships          FamilyMember[]
  studentProfile             StudentProfile?
  tutoringBookingsAsCustomer TutoringBooking[]        @relation("TutoringBookingCustomer")
  tutoringBookingsAsTutor    TutoringBooking[]        @relation("TutoringBookingTutor")
  tutoringSlots              TutoringSlot[]
  aiConversations            AIConversation[]
  aiMessages                 AIMessage[]

  @@map("user")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Permission {
  id    String           @id @default(cuid())
  name  String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model FacilitatorProfile {
  userId             String             @id
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty          String?
  experience         Int?
  credentialUrl      String?
  description        String?
  verificationStatus VerificationStatus @default(Pending)
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ==========================================
// ACADEMICS & BOOKINGS
// ==========================================

model PendingEnrollment {
  id              String                  @id @default(cuid())
  name            String
  email           String
  phoneNumber     String?
  gradeLevel      String
  subject         String
  enrollmentType  EnrollmentTrack
  topic           String?                 @db.Text
  sessionDate     DateTime
  startTime       DateTime
  endTime         DateTime
  educatorId      String?
  educator        User?                   @relation(fields: [educatorId], references: [id], onDelete: SetNull)
  amount          Int // Stored in cents
  stripeSessionId String?                 @unique
  status          PendingEnrollmentStatus @default(Pending)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([email])
  @@index([status])
}

model Appointment {
  id                      String            @id @default(cuid())
  learnerId               String
  learner                 User              @relation("LearnerAppointments", fields: [learnerId], references: [id], onDelete: Cascade)
  educatorId              String
  educator                User              @relation("EducatorAppointments", fields: [educatorId], references: [id], onDelete: Cascade)
  subject                 String
  gradeLevel              String
  date                    DateTime
  startTime               DateTime
  endTime                 DateTime
  learnerDescription      String?           @db.Text
  status                  AppointmentStatus @default(Scheduled)
  stripeCheckoutSessionId String?
  paymentIntentId         String?
  payoutStatus            PayoutStatus      @default(Unpaid)
  videoSessionId          String?
  videoSessionToken       String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  tutoringSlotId          String?           @unique
  tutoringSlot            TutoringSlot?     @relation(fields: [tutoringSlotId], references: [id], onDelete: SetNull)
  whiteboard              Whiteboard?

  @@index([status, startTime])
  @@index([educatorId, startTime])
  @@index([learnerId, createdAt])
}

// ==========================================
// PRODUCTS & COURSES
// ==========================================

model Product {
  id                 String               @id @default(cuid())
  title              String
  description        String               @db.Text
  slug               String               @unique
  gradeLevel         GradeLevel
  subjectId          String
  subject            Subject              @relation(fields: [subjectId], references: [id])
  topicId            String
  topic              Topic                @relation(fields: [topicId], references: [id])
  type               ProductType
  accessModel        ProductAccessModel   @default(INDIVIDUAL)
  price              Int? // Stored in cents
  printedPrice       Int?
  duration           Int?
  category           String?
  imageKey           String? // Course thumbnail image key
  status             ProductStatus        @default(Draft)
  fileKey            String?
  fileType           String?
  fileSize           Int?
  downloadCount      Int                  @default(0)
  stripePriceId      String?              @unique
  userId             String
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters           Chapter[]
  enrollments        Enrollment[]
  enrollmentProgress EnrollmentProgress[]
  purchases          Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gradeLevel])
  @@index([subjectId])
  @@index([topicId])
  @@index([gradeLevel, subjectId, topicId])
  @@index([gradeLevel, subjectId, topicId, type])
}

model Subject {
  id               String            @id @default(cuid())
  name             String
  description      String?
  topics           Topic[]
  products         Product[]
  videoGenerations VideoGeneration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

model Topic {
  id         String     @id @default(cuid())
  name       String
  slug       String
  gradeLevel GradeLevel
  subjectId  String
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  products   Product[]

  videoGenerations VideoGeneration[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([subjectId, gradeLevel, slug])
  @@index([gradeLevel, subjectId])
  @@index([gradeLevel, subjectId, slug])
}

model Chapter {
  id       String @id @default(cuid())
  title    String
  position Int

  // A chapter can belong to the legacy downloadable Product
  // or the newer structured Course.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([courseId])
}

model Lesson {
  id             String           @id @default(cuid())
  title          String
  description    String?          @db.Text
  thumbnailKey   String?
  videoKey       String?
  position       Int
  chapterId      String
  chapter        Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([chapterId])
}

model Purchase {
  id                    String   @id @default(cuid())
  userId                String
  productId             String
  amount                Int
  quantity              Int      @default(1)
  stripeSessionId       String
  stripePaymentIntentId String?
  status                String   @default("Paid")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([stripeSessionId, productId])
  @@index([userId])
  @@index([productId])
}

model Enrollment {
  id        String           @id @default(cuid())
  amount    Int // Stored in cents
  status    EnrollmentStatus @default(Pending)
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, productId])
}

model EnrollmentProgress {
  id           String   @id @default(cuid())
  userId       String
  productId    String
  progress     Float    @default(0)
  lastLessonId String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt

  @@unique([userId, productId])
}

model LessonProgress {
  id        String   @id @default(cuid())
  completed Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

// ==========================================
// BILLING & PAYOUTS
// ==========================================

model Subscription {
  id                   String             @id @default(cuid())
  stripeSubscriptionId String?            @unique
  interval             String
  status               SubscriptionStatus
  planId               PlanType
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  userId               String?            @unique
  user                 User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Payout {
  id          String       @id @default(cuid())
  educatorId  String
  educator    User         @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  amount      Int // Stored in cents
  platformFee Int // Stored in cents
  netAmount   Int // Stored in cents
  paypalEmail String
  status      PayoutStatus @default(Processing)
  processedBy String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([educatorId, status])
}

model Transaction {
  id                    String            @id @default(cuid())
  userId                String?
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount                Int // Stored in cents
  stripeSessionId       String?
  stripePaymentIntentId String?
  status                TransactionStatus @default(Pending)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([status])
}

// ==========================================
// MY PORTFOLIO MODELS
// ==========================================

model InvestmentAccount {
  id            String       @id @default(cuid())
  userId        String
  institution   String       @default("Fidelity Investments")
  accountNumber String
  accountName   String?
  accountType   String?
  currency      CurrencyType @default(USD)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  investments Investment[]

  @@unique([userId, institution, accountNumber])
  @@index([userId])
}

model Investment {
  id                    String                    @id @default(cuid())
  userId                String
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String?
  investmentAccount     InvestmentAccount?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  name                  String
  tickerOrSymbol        String?
  cusip                 String?
  accountNumber         String?
  accountName           String?
  institution           String?                   @default("Fidelity Investments")
  assetClass            AssetType
  region                RegionType
  currency              CurrencyType
  type                  InvestmentTransactionType
  shares                Float?
  pricePerShare         Float?
  amount                Float
  grossAmount           Float?
  fees                  Float                     @default(0)
  taxes                 Float                     @default(0)
  costBasis             Float?
  realizedGain          Float?
  marketValue           Float?
  unrealizedGain        Float?
  unrealizedGainPercent Float?
  cashBalance           Float?
  exchangeRate          Float                     @default(1)
  amountUSD             Float
  date                  DateTime
  settlementDate        DateTime?
  source                String?
  sourceFile            String?
  importBatchId         String?
  fingerprint           String?                   @unique
  status                StatusType
  notes                 String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([userId, date])
  @@index([userId, tickerOrSymbol])
  @@index([userId, accountNumber])
  @@index([userId, type])
  @@index([userId, importBatchId])
}

model Whiteboard {
  id            String       @id @default(cuid())
  userId        String
  appointmentId String?      @unique
  bookingId     String?      @unique
  isStandalone  Boolean      @default(false)
  name          String       @default("Untitled Whiteboard")
  data          Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  booking       Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isStandalone])
}

model SiteVisitor {
  id               String         @id @default(cuid())
  visitorId        String         @unique
  firstSeen        DateTime       @default(now())
  lastSeen         DateTime       @default(now())
  pageViews        Int            @default(0)
  pageViewsRecords SitePageView[]

  @@index([lastSeen])
  @@index([firstSeen])
}

model SitePageView {
  id        String      @id @default(cuid())
  visitorId String
  path      String
  createdAt DateTime    @default(now())
  visitor   SiteVisitor @relation(fields: [visitorId], references: [visitorId], onDelete: Cascade)

  @@index([visitorId])
  @@index([createdAt])
  @@index([path])
}

// ==========================================
// AI VIDEO GENERATION
// ==========================================

model VideoGeneration {
  id                 String                @id @default(cuid())
  userId             String
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId          String?
  subject            Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId            String?
  topic              Topic?                @relation(fields: [topicId], references: [id], onDelete: SetNull)
  gradeLevel         GradeLevel?
  title              String?
  prompt             String                @db.Text
  style              String?
  duration           Int
  aspectRatio        String                @default("16:9")
  provider           String
  model              String?
  providerTaskId     String?
  requestId          String?               @unique
  status             VideoGenerationStatus @default(PENDING)
  videoUrl           String?               @db.Text
  thumbnailUrl       String?               @db.Text
  creditsUsed        Int                   @default(0)
  creditChargedAt    DateTime?
  creditRefundedAt   DateTime?
  errorMessage       String?               @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  completedAt        DateTime?
  creditTransactions CreditTransaction[]
  AIMessage          AIMessage[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([providerTaskId])
  @@index([requestId])
  @@index([subjectId])
  @@index([topicId])
}

model UserCredit {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
}

model CreditTransaction {
  id             String                @id @default(cuid())
  userId         String
  userCreditId   String
  amount         Int
  type           CreditTransactionType
  description    String?
  generationId   String?
  aiGenerationId String?
  createdAt      DateTime              @default(now())
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userCredit     UserCredit            @relation(fields: [userCreditId], references: [id], onDelete: Cascade)
  generation     VideoGeneration?      @relation(fields: [generationId], references: [id], onDelete: SetNull)
  aiGeneration   AIGeneration?         @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userCreditId])
  @@index([generationId])
  @@index([aiGenerationId])
  @@index([createdAt])
}

model AIGeneration {
  id                 String                 @id @default(cuid())
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId          String?
  project            AIProject?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type               AIGenerationType
  operation          AIGenerationOperation?
  requestId          String?                @unique
  status             AIGenerationStatus     @default(PENDING)
  prompt             String                 @db.Text
  inputData          Json?
  outputData         Json?
  provider           String?
  model              String?
  providerTaskId     String?
  creditsUsed        Int                    @default(0)
  creditOperation    AIGenerationOperation?
  creditChargedAt    DateTime?
  creditRefundedAt   DateTime?
  errorMessage       String?                @db.Text
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  assets             AIAsset[]
  creditTransactions CreditTransaction[]
  AIMessage          AIMessage[]

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([status])
  @@index([providerTaskId])
  @@index([userId, requestId])
}

model AIProject {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?          @db.Text
  type          AIProjectType    @default(GENERAL)
  status        AIProjectStatus  @default(ACTIVE)
  context       Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  generations   AIGeneration[]
  assets        AIAsset[]
  conversations AIConversation[]

  @@index([userId, updatedAt])
}

model AIAsset {
  id String @id @default(cuid())

  userId       String
  projectId    String?
  generationId String?

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    AIProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  generation AIGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  type AIAssetType
  name String

  fileKey      String?
  url          String? @db.Text
  thumbnailUrl String? @db.Text

  mimeType String?
  fileSize Int?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([generationId])
}

// ==========================================
// UNIVERSAL USER / CAPABILITY ARCHITECTURE
// ==========================================

model LearningProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradeLevel        GradeLevel?
  schoolName        String?
  learningGoals     String?     @db.Text
  preferredSubjects Json?
  interests         Json?
  preferredLanguage String?
  timezone          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model TeachingProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline           String?
  specialty          String?
  experience         Int?
  credentialUrl      String?
  description        String?            @db.Text
  verificationStatus VerificationStatus @default(Pending)
  hourlyRate         Int?
  currency           CurrencyType       @default(USD)
  subjects           Json?
  gradeLevels        Json?
  courses            Course[]
  services           Service[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model CreatorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  bio         String?  @db.Text
  specialties Json?
  websiteUrl  String?
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Capability {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  users       UserCapability[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserCapability {
  userId       String
  capabilityId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, capabilityId])
  @@index([capabilityId])
}

model UserPermission {
  userId     String
  permission String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, permission])
  @@index([permission])
}

// ==========================================
// SOCIAL / RELATIONSHIPS
// ==========================================

model Follow {
  followerId  String
  followingId String
  follower    User     @relation("FollowingUser", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowedUser", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(Pending)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
}

// ==========================================
// SERVICES / TUTORING MARKETPLACE
// ==========================================

model Service {
  id                String           @id @default(cuid())
  providerId        String
  provider          User             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  teachingProfileId String?
  teachingProfile   TeachingProfile? @relation(fields: [teachingProfileId], references: [id], onDelete: SetNull)
  title             String
  description       String?          @db.Text
  type              ServiceType      @default(TUTORING)
  durationMinutes   Int?
  price             Int?
  currency          CurrencyType     @default(USD)
  status            ServiceStatus    @default(Draft)
  subject           String?
  gradeLevels       Json?
  bookings          Booking[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([providerId, status])
  @@index([type, status])
}

model Availability {
  id         String     @id @default(cuid())
  educatorId String
  educator   User       @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  startTime  DateTime
  endTime    DateTime
  status     SlotStatus @default(Available)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  bookings   Booking[]

  @@index([educatorId, startTime])
  @@index([status, startTime])
}

model Booking {
  id                String        @id @default(cuid())
  studentId         String
  student           User          @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  educatorId        String
  educator          User          @relation("EducatorBookings", fields: [educatorId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  availabilityId    String?
  availability      Availability? @relation(fields: [availabilityId], references: [id], onDelete: SetNull)
  startTime         DateTime
  endTime           DateTime
  subject           String?
  gradeLevel        String?
  status            BookingStatus @default(Scheduled)
  description       String?       @db.Text
  stripeSessionId   String?
  paymentIntentId   String?
  payoutStatus      PayoutStatus  @default(Unpaid)
  videoSessionId    String?
  videoSessionToken String?
  whiteboard        Whiteboard?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([studentId, startTime])
  @@index([educatorId, startTime])
  @@index([status, startTime])
  @@index([availabilityId])
}

// ==========================================
// STRUCTURED COURSES
// ==========================================

model Course {
  id                String             @id @default(cuid())
  title             String
  description       String             @db.Text
  slug              String             @unique
  smallDescription  String?
  thumbnailKey      String?
  price             Int?
  duration          Int?
  level             CourseLevel        @default(Beginner)
  category          String?
  status            CourseStatus       @default(Draft)
  stripePriceId     String?            @unique
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  teachingProfileId String?
  teachingProfile   TeachingProfile?   @relation(fields: [teachingProfileId], references: [id], onDelete: SetNull)
  chapters          Chapter[]
  enrollments       CourseEnrollment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId, status])
  @@index([teachingProfileId])
}

model CourseEnrollment {
  id        String                 @id @default(cuid())
  courseId  String
  course    Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learnerId String
  learner   User                   @relation("CourseLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  amount    Int?
  status    CourseEnrollmentStatus @default(Pending)
  progress  Float                  @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([courseId, learnerId])
  @@index([learnerId, status])
}

// ==========================================
// ORGANIZATIONS / SCHOOLS FOUNDATION
// ==========================================

model Organization {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  type        OrganizationType         @default(SCHOOL)
  description String?
  logoUrl     String?
  websiteUrl  String?
  status      OrganizationStatus       @default(ACTIVE)
  ownerId     String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  classrooms  Classroom[]
  owner       User?                    @relation(fields: [ownerId], references: [id])
  memberships OrganizationMembership[]

  @@index([ownerId])
  @@index([type, status])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([organizationId, status])
  @@index([userId])
}

model Classroom {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  description    String?
  gradeLevel     String?
  subject        String?
  schoolYear     String?
  status         ClassroomStatus    @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students       ClassroomStudent[]
  teachers       ClassroomTeacher[]

  @@index([organizationId, gradeLevel])
  @@index([organizationId, status])
  @@index([organizationId, subject])
}

model ClassroomStudent {
  classroomId String
  userId      String
  joinedAt    DateTime  @default(now())
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classroomId, userId])
  @@index([userId])
}

model ClassroomTeacher {
  classroomId String
  userId      String
  isPrimary   Boolean   @default(false)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classroomId, userId])
  @@index([userId])
}

model Family {
  id        String         @id @default(cuid())
  name      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   FamilyMember[]
}

model FamilyMember {
  familyId String
  userId   String
  role     FamilyRole
  joinedAt DateTime   @default(now())
  family   Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([familyId, userId])
  @@index([familyId, role])
  @@index([userId])
}

model StudentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  gradeLevel    String?
  bio           String?
  learningStyle String?
  preferredPace String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gradeLevel])
}

model TutoringBooking {
  id                   String                @id @default(cuid())
  customerId           String
  tutorId              String
  tutoringSlotId       String                @unique
  subject              String
  gradeLevel           String
  topic                String?
  description          String?
  amount               Int
  currency             String                @default("usd")
  status               TutoringBookingStatus @default(PENDING_PAYMENT)
  stripeSessionId      String?               @unique
  paymentIntentId      String?
  stripeSubscriptionId String?
  appointmentId        String?               @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  customer             User                  @relation("TutoringBookingCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  tutor                User                  @relation("TutoringBookingTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  tutoringSlot         TutoringSlot          @relation(fields: [tutoringSlotId], references: [id])

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([tutorId, createdAt])
  @@index([tutorId, status])
}

model TutoringSlot {
  id              String           @id @default(cuid())
  tutorId         String
  startTime       DateTime
  endTime         DateTime
  status          SlotStatus       @default(Available)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  appointment     Appointment?
  tutoringBooking TutoringBooking?
  tutor           User             @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([tutorId, startTime, endTime])
  @@index([tutorId, startTime])
  @@index([tutorId, status, startTime])
}

model AIRateLimitBucket {
  id           String   @id @default(cuid())
  key          String   @unique
  windowStart  DateTime
  requestCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([windowStart])
}

model AIConversation {
  id              String               @id @default(cuid())
  userId          String
  projectId       String?
  title           String               @default("New Chat")
  model           String?
  status          AIConversationStatus @default(ACTIVE)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  activeMessageId String?
  metadata        Json?
  activeMessage   AIMessage?           @relation("AIConversationActiveMessage", fields: [activeMessageId], references: [id])
  project         AIProject?           @relation(fields: [projectId], references: [id])
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        AIMessage[]          @relation("AIConversationMessages")

  @@index([activeMessageId])
  @@index([projectId])
  @@index([userId, status])
  @@index([userId, updatedAt])
}

model AIMessage {
  id                String           @id @default(cuid())
  conversationId    String
  userId            String
  role              AIMessageRole
  content           String
  attachments       Json?
  metadata          Json?
  generationId      String?
  createdAt         DateTime         @default(now())
  parentMessageId   String?
  videoGenerationId String?
  conversation      AIConversation   @relation("AIConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  activeIn          AIConversation[] @relation("AIConversationActiveMessage")
  generation        AIGeneration?    @relation(fields: [generationId], references: [id])
  parent            AIMessage?       @relation("AIMessageParent", fields: [parentMessageId], references: [id])
  children          AIMessage[]      @relation("AIMessageParent")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoGeneration   VideoGeneration? @relation(fields: [videoGenerationId], references: [id])

  @@index([conversationId, createdAt])
  @@index([generationId])
  @@index([parentMessageId])
  @@index([userId, createdAt])
  @@index([videoGenerationId])
}

